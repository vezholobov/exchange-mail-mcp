# Exchange Mail MCP — example configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# IMPORTANT: this connector is designed for corporate Exchange servers that
# are reachable only over a corporate VPN. Ensure the VPN interface is up
# before starting the service, otherwise /ready will report not-ready.

EXCHANGE_USER=DOMAIN\username
EXCHANGE_PASS=
EXCHANGE_EMAIL=user@example.com
EXCHANGE_SERVER=exchange.example.com

# Comma-separated CORS allow-list for the REST API
CORS_ORIGINS=http://localhost:3000,http://localhost:8080